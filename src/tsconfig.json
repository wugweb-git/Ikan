{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    /* Path mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@components/*": ["./components/*"],
      "@lib/*": ["./lib/*"],
      "@utils/*": ["./utils/*"],
      "@contexts/*": ["./contexts/*"],
      "@hooks/*": ["./hooks/*"]
    },

    /* Additional options for better development experience */
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,
    "removeComments": false,
    "importHelpers": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  // No `references` here. tsconfig.node.json previously declared both
  // `composite: true` and `noEmit: true`, which TypeScript rejects for a
  // referenced project (TS6310) — so `tsc -p src/tsconfig.json` could not load
  // at all, and no type check has ever run against this repo. Dropping the
  // reference and the `composite` flag makes both configs load standalone.
  "include": [
    "./App.tsx",
    "./components/**/*.ts",
    "./components/**/*.tsx",
    "./contexts/**/*.ts",
    "./contexts/**/*.tsx",
    "./hooks/**/*.ts",
    "./hooks/**/*.tsx",
    "./lib/**/*.ts",
    "./lib/**/*.tsx",
    "./admin/**/*.ts",
    "./admin/**/*.tsx",
    "./app/**/*.ts",
    "./app/**/*.tsx",
    "./site/**/*.ts",
    "./site/**/*.tsx",
    "./shared/**/*.ts",
    "./shared/**/*.tsx",
    "./utils/**/*.ts",
    "./utils/**/*.tsx",
    "./styles/**/*.css"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "supabase",
    "scripts",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}