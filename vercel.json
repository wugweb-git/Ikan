{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/assessment/:slug*",
      "destination": "https://app.ikanhealth.in/assessments",
      "permanent": true
    },
    {
      "source": "/assessment",
      "destination": "https://app.ikanhealth.in/assessments",
      "permanent": true
    },
    {
      "source": "/equip/:slug*",
      "destination": "https://app.ikanhealth.in/program",
      "permanent": true
    },
    {
      "source": "/equip",
      "destination": "https://app.ikanhealth.in/program",
      "permanent": true
    },
    {
      "source": "/resource/:slug*",
      "destination": "https://app.ikanhealth.in/resources",
      "permanent": true
    },
    {
      "source": "/resource",
      "destination": "https://app.ikanhealth.in/resources",
      "permanent": true
    },
    {
      "source": "/consultation/:slug*",
      "destination": "https://app.ikanhealth.in/consult",
      "permanent": true
    },
    {
      "source": "/consultation",
      "destination": "https://app.ikanhealth.in/consult",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/((?!assets/|sw\\.js|manifest\\.json).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-2+mVc3wqU67wgZhYS7AaRHKOokW7aupA2IEGjxyjLxU=' https://www.googletagmanager.com https://checkout.razorpay.com https://*.razorpay.com https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://jpfvoevxegnknxoqmwye.supabase.co wss://jpfvoevxegnknxoqmwye.supabase.co https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://api.razorpay.com https://lumberjack.razorpay.com https://*.razorpay.com https://www.googleapis.com https://nominatim.openstreetmap.org https://ipapi.co https://api.open-meteo.com https://va.vercel-scripts.com https://vitals.vercel-insights.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://*.razorpay.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://player.vimeo.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "github": {
    "enabled": true,
    "autoJobCancelation": false
  }
}
